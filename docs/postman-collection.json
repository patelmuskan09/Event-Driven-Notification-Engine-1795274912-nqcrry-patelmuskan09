{
  "info": {
    "name": "Event-Driven Financial Notification Engine (BE-6B)",
    "_postman_id": "be6b-notification-engine-collection",
    "description": "Postman collection covering Authentication, Event Ingestion, Preferences, Consent, Tracking, Webhooks, Analytics, DLQ, Providers, Health, Metrics, and the 5 Simulation Challenges.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth - Login (ADMIN)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@brokerage.local\",\n  \"password\": \"admin-local-dev\"\n}"
        }
      }
    },
    {
      "name": "2. Auth - Rotate Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      }
    },
    {
      "name": "3. Ingest Critical Margin Call (RISK-001)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"RISK-001\",\n  \"userId\": \"USR-894120\",\n  \"sourceSystem\": \"RMS\",\n  \"payload\": {\n    \"account_id\": \"ACC-894120\",\n    \"required_margin\": 250000,\n    \"available_margin\": 180000,\n    \"shortfall\": 70000,\n    \"deadline_time\": \"2026-11-15T14:30:00Z\"\n  }\n}"
        }
      }
    },
    {
      "name": "4. List Notifications (Paginated)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/notifications?page=1&limit=20"
      }
    },
    {
      "name": "5. Get User Preferences",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/users/USR-894120/preferences"
      }
    },
    {
      "name": "6. Analytics - Delivery Rates & P99",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/analytics/delivery-rates"
      }
    },
    {
      "name": "7. Operations - Providers Health & Circuit Breakers",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/providers/health"
      }
    },
    {
      "name": "8. Operations - Dead Letter Queue",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/dlq"
      }
    },
    {
      "name": "9. Simulation - Challenge 1 Market Crash",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/simulations/market-crash",
        "body": { "mode": "raw", "raw": "{\n  \"sampleSize\": 30\n}" }
      }
    },
    {
      "name": "10. Health & Prometheus Metrics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
