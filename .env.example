# ==========================================
# Event-Driven Notification Engine Environment Configuration (BE-6B)
# ==========================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=NotificationEngine-BE-6B

# Authentication, JWT & Security Secrets (Must be strong random values in production)
APP_SECRET=replace-with-strong-jwt-access-secret-min-32-chars
REFRESH_TOKEN_SECRET=replace-with-strong-jwt-refresh-secret-min-32-chars
TOKEN_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_SECONDS=604800
PII_ENCRYPTION_KEY=replace-with-32-byte-aes256-pii-encryption-key
WEBHOOK_HMAC_SECRET=replace-with-strong-webhook-hmac-sha256-secret
ENABLE_AUTH_ENFORCEMENT=true
AUTH_ADMIN_PASSWORD=replace-with-admin-password
AUTH_OPERATOR_PASSWORD=replace-with-operator-password
AUTH_SERVICE_KEY=replace-with-service-api-key

# Feature Toggles for Infrastructure & Delivery Mode
ENABLE_POSTGRES=true
ENABLE_REDIS=true
ENABLE_KAFKA=true
ENABLE_RABBITMQ=true
ENABLE_REAL_PROVIDERS=false

# Database (PostgreSQL 15+)
DATABASE_URL=postgres://notification_user:notification_pass@localhost:5432/notifications_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=notification_user
DB_PASSWORD=notification_pass
DB_NAME=notifications_db
DB_SSL=false
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT_MS=10000

# Redis Cache & State (Redis 7+)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ne:

# Apache Kafka Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-engine
KAFKA_GROUP_ID=notification-engine-consumer-group
KAFKA_TOPIC_EVENTS=notification-events
KAFKA_TOPIC_CRITICAL=notification-critical
KAFKA_TOPIC_DLQ=notification-dlq
KAFKA_SSL=false

# RabbitMQ Delivery Routing
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE_NAME=notifications.direct
RABBITMQ_CRITICAL_QUEUE=notifications.priority.critical
RABBITMQ_HIGH_QUEUE=notifications.priority.high
RABBITMQ_STANDARD_QUEUE=notifications.priority.standard
RABBITMQ_DLQ=notifications.delivery.dlq

# Delivery Provider Sandbox & API Keys (Enable live HTTP calls only when ENABLE_REAL_PROVIDERS=true)
MSG91_AUTH_KEY=test_msg91_auth_key_sandbox
MSG91_SENDER_ID=FINNOT
TWILIO_ACCOUNT_SID=AC_dummy_twilio_account_sid_test_mode
TWILIO_AUTH_TOKEN=test_twilio_auth_token_secret
TWILIO_FROM_NUMBER=+15005550006
FCM_SERVER_KEY=test_fcm_http_v1_server_key_json
APNS_KEY_ID=test_apns_key_id
WHATSAPP_TOKEN=test_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=10987654321
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user@ethereal.email
SMTP_PASS=ethereal_password

# Compliance & Capping Defaults
TRAI_DND_ENFORCED=true
GLOBAL_USER_DAILY_CAP=12
SMS_DAILY_CAP=5
PUSH_DAILY_CAP=8
EMAIL_DAILY_CAP=3
CATEGORY_HOURLY_CAP=3
SAME_EVENT_COOLDOWN_MINUTES=15
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
DEFAULT_TIMEZONE=Asia/Kolkata
